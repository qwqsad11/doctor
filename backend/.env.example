# ============================================================
# 环境变量参考模板
# 后端按 NODE_ENV 加载：.env.development（开发）或 .env.production（生产）。
# 开发环境可直接用仓库里的 .env.development，无需复制本文件。
# 生产环境：复制本文件为 .env.production 并修改敏感项。
# ============================================================

NODE_ENV=development
PORT=3001

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=doctor_service_dev

# JWT 认证（生产务必换成强随机密钥）
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# 跨域来源（前端地址）
CORS_ORIGIN=http://localhost:3000

# ============================================================
# 开发环境配置（后端会读取 .env.${NODE_ENV}，开发默认加载本文件）
# 说明：以下均为开发默认值，无敏感信息，可直接提交仓库。
#       生产环境请创建 .env.production（已被 .gitignore 忽略），
#       并务必更换 JWT_SECRET 与数据库口令。
# ============================================================

NODE_ENV=development
PORT=3001

# PostgreSQL（与根目录 docker-compose.yml 保持一致）
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=doctor_service_dev

# JWT 认证
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRES_IN=7d

# 跨域来源（前端地址）
CORS_ORIGIN=http://localhost:3000
